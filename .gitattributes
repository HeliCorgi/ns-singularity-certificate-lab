* text=auto eol=lf
*.npz binary

# Evidence checksums cover the generated bytes, including line endings.
/outputs/** -text
/certificates/** -text

# Keep GitHub/source archives small without deleting preserved evidence from
# repository history.  Update the explicit exceptions when a new current
# evidence generation supersedes these directories.
/.pytest_cache/** export-ignore
/.mypy_cache/** export-ignore
/.ruff_cache/** export-ignore
/.venv/** export-ignore
/venv/** export-ignore
/tests/_scratch/** export-ignore
/build/** export-ignore
/dist/** export-ignore
/outputs/** export-ignore
/outputs/README.md -export-ignore
/outputs/manufactured_v5/** -export-ignore
/outputs/baseline_v5/** -export-ignore
/outputs/time_convergence_v1/** -export-ignore
