      "axis_parity_argmax_z_u1",
      "axis_parity_argmax_z_omega1"
    ],
    "symmetry": "full z period, odd symmetry monitored not imposed",
    "time_integrator": "explicit Heun/RK2 (nominal order 2)",
    "time_step_rule": "fixed uniform dt per member; the ladder is dt, dt/2, dt/4 with step counts n, 2n, 4n landing exactly on t_final",
    "viscosity_protocol": "single E-30 stage: t_final = T_1 lies below the switch time t_0 = 0.00227375, so no viscosity switch occurs",
    "wall_conditions": "E-27 with the second-order Thom form E-31"
  },
